# syntax=docker/dockerfile:1
#
# Build, test and lint the SDK.
#
# The host is not asked for a Python toolchain or a virtualenv. Everything runs
# here at a pinned version, so a contributor needs only Docker and every check
# is reproducible. The same reasoning as meridian-core's Dockerfile.rust, and
# the same reason: a gate whose verdict depends on whose machine ran it is not
# a gate.

ARG PYTHON_VERSION=3.12

FROM python:${PYTHON_VERSION}-slim AS base
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /w
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1

# Dependencies resolve before the source is copied, so editing the SDK does not
# re-fetch the pinned schema revision on every run.
COPY pyproject.toml ./
RUN mkdir -p src/meridian_sdk && touch src/meridian_sdk/__init__.py \
 && pip install -e ".[dev]"

# The domain messages the tests encode payloads with. They are meridian-core's,
# not this package's, and the package never ships them: the image generates
# them beside the plugin-facing bindings from the proto/ it is handed as the
# core-proto build context (see CORE_PROTO in the Makefile).
COPY --from=core-proto . /core-proto/
RUN site="$(python -c 'import meridian, pathlib; print(pathlib.Path(meridian.__file__).parents[1])')" \
 && python -m grpc_tools.protoc -I /core-proto \
      --python_out="$site" --pyi_out="$site" /core-proto/meridian/v1/*.proto \
 && python -c "import meridian.v1.holdings_pb2, meridian.v1.envelope_pb2"

COPY src/ src/
COPY tests/ tests/

FROM base AS check
RUN python -c "import meridian_sdk; print(meridian_sdk.SCHEMA_VERSION)"

# The conformance half needs the design repo's fixtures, which are not in this
# repo and are not copied into the image: they are mounted at run time, because
# baking a copy in is the vendored-copy problem again.
FROM base AS test
RUN python -m pytest -q --ignore=tests/test_conformance.py --ignore=tests/test_interop.py

FROM base AS lint
RUN python -m ruff check src tests \
 && python -m ruff format --check src tests \
 && python -m mypy

# Conformance against the contract's pinned bytes. The fixtures live in
# meridian-design and are mounted rather than copied, because a copy is a copy
# that drifts, which is the thing this suite exists to detect.
FROM base AS conformance

# The SDK against a real runtime. Needs one running and reachable, which is why
# meridian-core owns the target that starts it: the sidecar binds loopback, so
# this container joins the runtime's network namespace rather than its network.
FROM base AS interop
